# Trend Scout: free, local-first configuration
# Keep your actual .env private and never put API keys in this example file.
ENABLE_SCHEDULER=false
ENABLE_X_SCAN=false
ENABLE_X_WATCHLIST=false
ENABLE_X_TIMELINE=false
ENABLE_WEB_SCAN=true
MAX_WEB_RESULTS=80
WEB_KEYWORDS=openai,chatgpt,gpt,anthropic,claude,gemini,deepmind,meta ai,llama,grok,kimi,moonshot,deepseek,qwen,mistral,hugging face,ai model,developer tools,agents,chips
WEB_FEED_URLS=https://techcrunch.com/feed/,https://news.ycombinator.com/rss,https://huggingface.co/blog/feed.xml

# Local and free text generation. Keep the Ollama desktop app running.
ENABLE_OLLAMA=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=90

# Source quality gate. This stays free and local by default.
ENABLE_VERIFIED_BRIEF=true
VERIFIED_MAX_AGE_HOURS=72

# Optional paid current-web research through the OpenAI Responses API.
# This is off by default and is intentionally absent from the local free setup.
ENABLE_OPENAI_RESEARCH=false
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5
OPENAI_RESEARCH_TIMEOUT_SECONDS=240

# Optional cloud-only draft writer (used by the GitHub Actions workflow).
ENABLE_OPENAI_DRAFTS=false
OPENAI_DRAFT_MODEL=gpt-5

# Optional Telegram delivery for cloud-created drafts. Telegram is a delivery inbox, not the database.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
